{
  "name": "poker-practice",
  "type": "module",
  "private": true,
  "version": "0.1.0-rc.2",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "check:dist": "node tools/check-dist.mjs",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint apps packages tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:tools": "node --test tools/check-dist.test.mjs tools/serve-dist.test.mjs tools/smoke-live-lib.test.mjs",
    "test:rules": "vitest run --config vitest.config.ts packages/poker",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:release": "playwright test",
    "test:db": "node tools/test-db.mjs",
    "benchmark": "node --import tsx tools/benchmarks/run.ts",
    "benchmark:browser": "node tools/benchmarks/browser-latency.mjs",
    "check": "node tools/run-check.mjs",
    "smoke:live": "node tools/smoke-live.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "supabase": "2.119.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.0.18",
    "wrangler": "4.131.1"
  }
}
